# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Optional. If unset, the AI Tutor automatically runs in Local Tutor
# (deterministic offline knowledge pack) mode instead of calling the cloud model.
ANTHROPIC_API_KEY=

# Path to the SQLite database file (created automatically on first run).
DB_PATH=./data/hlg.sqlite

# Simulated latency (ms) for the Mock Satellite Gateway, so the demo is visibly
# "syncing" rather than instant.
MOCK_SATELLITE_LATENCY_MS=900
