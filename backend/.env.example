# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Optional. If unset, the AI Tutor automatically runs in Local Tutor
# (deterministic offline knowledge pack) mode instead of calling the cloud model.
ANTHROPIC_API_KEY=

# Path to the SQLite database file (created automatically on first run).
DB_PATH=./data/hlg.sqlite

# Simulated latency (ms) for the Mock Satellite Gateway, so the demo is visibly
# "syncing" rather than instant.
MOCK_SATELLITE_LATENCY_MS=900

# NVIDIA API for AI Tutor (Hima) — REQUIRED for AI answers.
# Get a key at https://build.nvidia.com and paste it below.
NVIDIA_NEMOTRON_API_KEY=your_nvidia_api_key_here

# Live satellite orbits (Learning Satellite page) — NO key needed.
# Uncomment only to point at a different CelesTrak-compatible mirror.
# CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php


# Field Camera (Sync page) AI auto-label uses the same NVIDIA key above.
# Optional: force a specific vision model (default tries nemotron-nano-12b-v2-vl,
# then llama-3.2-90b-vision-instruct, then llama-3.2-11b-vision-instruct).
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
